# Copia este archivo como .env y configura valores reales en tu equipo.
SERVER_PORT=8080
# Supabase PostgreSQL (usar el host/puerto/usuario indicados en Database > Connect)
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_DE_BASE_DE_DATOS
# Secreto aleatorio de al menos 32 bytes. Ejemplo de generación: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
JWT_EXPIRATION_MS=3600000
CORS_ORIGIN=http://localhost:4200
# El administrador se crea una vez al arrancar si este correo todavía no existe.
ADMIN_EMAIL=admin@galatech.local
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_UNICA_DE_12_CARACTERES_O_MAS
ADMIN_NAME=Administrador GALATECH
